// Cloudflare Worker for dandystrength.com (worker/index.js).
// The app: any path that is not a real file (like /prs or /u/<id>) serves index.html and the app routes it.
// Gym websites: /site/<key>, <key>.dandystrength.com and gyms' own domains render the one template in site/gs.
{
  "name": "dsi",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
