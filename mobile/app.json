{
  "expo": {
    "name": "DSI",
    "slug": "dsi",
    "owner": "dandy-strength",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dsi",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dandystrength.dsi",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1420",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dandystrength.dsi"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E1420"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DSI uses your photo library so you can attach a video of your lift.",
          "cameraPermission": "DSI uses the camera so you can record your lift.",
          "microphonePermission": "DSI records sound with your lift video."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0E1420",
    "extra": {
      "eas": {
        "projectId": "3acc4ce1-280f-40f1-963f-b922019f93a3"
      }
    }
  }
}
