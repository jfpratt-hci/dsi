{
  "expo": {
    "name": "Dandy Strength",
    "slug": "dsi",
    "owner": "dandy-strength",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dsi",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dandystrength.dsi",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Dandy"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1420",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dandystrength.dsi",
      "permissions": [
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_EXERCISE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E1420"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DSI uses your photo library so you can attach a video of your lift.",
          "cameraPermission": "DSI uses the camera so you can record your lift.",
          "microphonePermission": "DSI records sound with your lift video."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#F2C94C",
          "mode": "production"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Dandy reads your HRV, resting heart rate, sleep and bodyweight to give you a readiness call for lifting each morning.",
          "NSHealthUpdateUsageDescription": "Dandy saves the sessions you log as strength workouts in Apple Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0E1420",
    "extra": {
      "eas": {
        "projectId": "3acc4ce1-280f-40f1-963f-b922019f93a3"
      },
      "revenuecat": {
        "ios": "",
        "android": ""
      }
    }
  }
}
